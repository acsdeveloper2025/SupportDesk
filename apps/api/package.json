{
  "name": "@supportdesk/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "TS_NODE_PROJECT=tsconfig.json node --watch -r ts-node/register -r tsconfig-paths/register src/main.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage:auth": "vitest run --coverage --coverage.include='src/auth/**/*.ts' --coverage.include='src/identity/**/*.ts' --coverage.include='src/rbac/**/*.ts' --coverage.exclude='src/**/*.spec.ts' --coverage.exclude='src/**/*.repository.ts' --coverage.exclude='src/**/*.types.ts' --coverage.exclude='src/**/*.module.ts' --coverage.exclude='src/auth/registration/auth-notification.service.ts' --coverage.reporter=text-summary --coverage.thresholds.lines=90 --coverage.thresholds.functions=90 --coverage.thresholds.branches=70 --coverage.thresholds.statements=90",
    "test:integration": "bash scripts/run-integration-tests.sh",
    "prisma:generate": "prisma generate",
    "seed": "DATABASE_URL=\"postgresql://supportdesk:supportdesk@localhost:5432/supportdesk?schema=public\" TS_NODE_PROJECT=tsconfig.json node -r ts-node/register -r tsconfig-paths/register src/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.5",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.5",
    "@nestjs/platform-express": "^11.1.5",
    "@nestjs/swagger": "^11.2.0",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.13.0",
    "helmet": "^8.1.0",
    "jose": "^6.2.5",
    "luxon": "^3.7.2",
    "multer": "^2.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.5",
    "@supportdesk/tsconfig": "workspace:*",
    "@types/express": "^5.0.3",
    "@types/luxon": "^3.7.2",
    "@types/multer": "^2.2.0",
    "@types/supertest": "^6.0.3",
    "prisma": "^6.13.0",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0"
  }
}
