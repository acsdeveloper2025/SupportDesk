model AssetTypeKbLink {
  id              String   @id(map: "pk_asset_type_kb_links") @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  assetTypeId     String   @map("asset_type_id") @db.Uuid
