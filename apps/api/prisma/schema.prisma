  ticketId                 String                   @map("ticket_id") @db.Uuid
  type                     SlaTargetType
  state                    SlaTargetState           @default(RUNNING)
  policyVersionId          String                   @map("policy_version_id") @db.Uuid
  scheduleVersionId        String                   @map("schedule_version_id") @db.Uuid
  startedAt                DateTime                 @map("started_at") @db.Timestamptz(3)
  dueAt                    DateTime                 @map("due_at") @db.Timestamptz(3)
  pausedAt                 DateTime?                @map("paused_at") @db.Timestamptz(3)
  accumulatedPauseMs       BigInt                   @default(0) @map("accumulated_pause_ms")
  completedAt              DateTime?                @map("completed_at") @db.Timestamptz(3)
