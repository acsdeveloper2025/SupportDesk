  tenantId     String   @map("tenant_id") @db.Uuid
  requestId    String   @map("request_id") @db.Uuid
  fileName     String   @map("file_name") @db.VarChar(255)
  originalName String   @map("original_name") @db.VarChar(255)
  mimeType     String   @map("mime_type") @db.VarChar(120)
  sizeBytes    BigInt   @map("size_bytes")
  storagePath  String   @map("storage_path") @db.VarChar(500)
  uploadedById String   @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "fk_service_request_attachments__tenants__tenant_id")
  request    ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade, map: "fk_service_request_attachments__requests__request_id")
  uploadedBy User           @relation("ServiceRequestAttachmentUploader", fields: [uploadedById], references: [id], onDelete: Cascade, map: "fk_service_request_attachments__users__uploaded_by_id")

  @@index([tenantId, requestId], map: "idx_service_request_attachments__tenant_request")
  @@map("service_request_attachments")
}

model ServiceRequestHistory {
  id          String                @id(map: "pk_service_request_history") @default(uuid()) @db.Uuid
  tenantId    String                @map("tenant_id") @db.Uuid
  requestId   String                @map("request_id") @db.Uuid
  action      String                @db.VarChar(100)
  fromStatus  ServiceRequestStatus? @map("from_status")
  toStatus    ServiceRequestStatus? @map("to_status")
  actorUserId String?               @map("actor_user_id") @db.Uuid
  comment     String?               @db.VarChar(1000)
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "fk_service_request_history__tenants__tenant_id")
  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade, map: "fk_service_request_history__requests__request_id")
  actor   User?          @relation("ServiceRequestHistoryActor", fields: [actorUserId], references: [id], onDelete: SetNull, map: "fk_service_request_history__users__actor_user_id")

  @@index([tenantId, requestId, createdAt], map: "idx_service_request_history__tenant_request_created_at")
  @@map("service_request_history")
}

enum AssetLifecycleState {
  DRAFT     @map("draft")
  IN_STOCK  @map("in_stock")
  ASSIGNED  @map("assigned")
  IN_REPAIR @map("in_repair")
  RETIRED   @map("retired")
  DISPOSED  @map("disposed")
  LOST      @map("lost")
  ARCHIVED  @map("archived")

  @@map("asset_lifecycle_state")
}

enum AssetRelationshipType {
  PARENT_CHILD        @map("parent_child")
  DEPENDS_ON          @map("depends_on")
  CONNECTED_TO        @map("connected_to")
  INSTALLED_ON        @map("installed_on")
  HOSTED_ON           @map("hosted_on")
  LICENSE_ASSIGNED_TO @map("license_assigned_to")

  @@map("asset_relationship_type")
}

enum AssetAssignmentKind {
  USER       @map("user")
  DEPARTMENT @map("department")
  LOCATION   @map("location")

  @@map("asset_assignment_kind")
}

enum AssetAttachmentKind {
  PHOTO    @map("photo")
  INVOICE  @map("invoice")
  MANUAL   @map("manual")
  WARRANTY @map("warranty")
  OTHER    @map("other")

  @@map("asset_attachment_kind")
}

model AssetType {
  id                 String    @id(map: "pk_asset_types") @default(uuid()) @db.Uuid
  tenantId           String?   @map("tenant_id") @db.Uuid
  key                String    @db.VarChar(100)
  name               String    @db.VarChar(200)
  description        String?   @db.Text
  isSystem           Boolean   @default(false) @map("is_system")
  customFieldsSchema Json      @default("[]") @map("custom_fields_schema")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant  Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "fk_asset_types__tenants__tenant_id")
  assets  Asset[]
  kbLinks AssetTypeKbLink[]

  @@unique([tenantId, key], map: "uq_asset_types__tenant_id_key")
  @@index([tenantId, isSystem, deletedAt], map: "idx_asset_types__tenant_id_is_system_deleted_at")
  @@map("asset_types")
}

model AssetCategory {
  id           String    @id(map: "pk_asset_categories") @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  parentId     String?   @map("parent_id") @db.Uuid
  name         String    @db.VarChar(200)
  slug         String    @db.VarChar(200)
  description  String?   @db.Text
  icon         String?   @db.VarChar(100)
  displayOrder Int       @default(0) @map("display_order")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "fk_asset_categories__tenants__tenant_id")
  parent   AssetCategory?  @relation("AssetCategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull, map: "fk_asset_categories__parents__parent_id")
  children AssetCategory[] @relation("AssetCategoryHierarchy")
  assets   Asset[]

  @@unique([tenantId, slug], map: "uq_asset_categories__tenant_id_slug")
  @@index([tenantId, parentId], map: "idx_asset_categories__tenant_id_parent_id")
  @@map("asset_categories")
}

model AssetLocation {
  id          String    @id(map: "pk_asset_locations") @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String    @db.VarChar(200)
  description String?   @db.Text
  address     String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "fk_asset_locations__tenants__tenant_id")
  assets            Asset[]
  assignmentHistory AssetAssignment[]

  @@unique([tenantId, name], map: "uq_asset_locations__tenant_id_name")
  @@map("asset_locations")
}

model Asset {
  id                 String              @id(map: "pk_assets") @default(uuid()) @db.Uuid
  tenantId           String              @map("tenant_id") @db.Uuid
  assetRef           String              @map("asset_ref") @db.VarChar(50)
  name               String              @db.VarChar(255)
  assetTypeId        String              @map("asset_type_id") @db.Uuid
  categoryId         String?             @map("category_id") @db.Uuid
  serialNumber       String?             @map("serial_number") @db.VarChar(200)
  assetTag           String?             @map("asset_tag") @db.VarChar(100)
  barcode            String?             @db.VarChar(200)
  manufacturer       String?             @db.VarChar(200)
  model              String?             @db.VarChar(200)
  vendor             String?             @db.VarChar(200)
  purchaseDate       DateTime?           @map("purchase_date") @db.Date
  warrantyExpiresAt  DateTime?           @map("warranty_expires_at") @db.Date
  cost               Decimal?            @db.Decimal(12, 2)
  lifecycleState     AssetLifecycleState @default(DRAFT) @map("lifecycle_state")
  ownerUserId        String?             @map("owner_user_id") @db.Uuid
  locationId         String?             @map("location_id") @db.Uuid
  assignedUserId     String?             @map("assigned_user_id") @db.Uuid
  assignedDepartment String?             @map("assigned_department") @db.VarChar(200)
  notes              String?             @db.Text
  customFields       Json                @default("{}") @map("custom_fields")
  version            Int                 @default(1)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime?           @map("deleted_at") @db.Timestamptz(3)

  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "fk_assets__tenants__tenant_id")
  assetType           AssetType           @relation(fields: [assetTypeId], references: [id], onDelete: Restrict, map: "fk_assets__asset_types__asset_type_id")
  category            AssetCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull, map: "fk_assets__asset_categories__category_id")
  location            AssetLocation?      @relation(fields: [locationId], references: [id], onDelete: SetNull, map: "fk_assets__asset_locations__location_id")
  ownerUser           User?               @relation("AssetOwner", fields: [ownerUserId], references: [id], onDelete: SetNull, map: "fk_assets__users__owner_user_id")
  assignedUser        User?               @relation("AssetAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull, map: "fk_assets__users__assigned_user_id")
  assignments         AssetAssignment[]
  relationships       AssetRelationship[] @relation("AssetRelationshipSource")
  targetRelationships AssetRelationship[] @relation("AssetRelationshipTarget")
  history             AssetHistory[]
  ticketLinks         AssetTicketLink[]
  attachments         AssetAttachment[]

  @@unique([tenantId, assetRef], map: "uq_assets__tenant_id_asset_ref")
  @@unique([tenantId, assetTag], map: "uq_assets__tenant_id_asset_tag")
  @@index([tenantId, lifecycleState], map: "idx_assets__tenant_id_lifecycle_state")
  @@index([tenantId, assetTypeId], map: "idx_assets__tenant_id_asset_type_id")
  @@index([tenantId, categoryId], map: "idx_assets__tenant_id_category_id")
  @@index([tenantId, locationId], map: "idx_assets__tenant_id_location_id")
  @@index([tenantId, assignedUserId], map: "idx_assets__tenant_id_assigned_user_id")
  @@index([tenantId, ownerUserId], map: "idx_assets__tenant_id_owner_user_id")
  @@index([tenantId, createdAt], map: "idx_assets__tenant_id_created_at")
  @@index([tenantId, deletedAt], map: "idx_assets__tenant_id_deleted_at")
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_assets__name_trgm")
  @@index([assetTag(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_assets__asset_tag_trgm")
  @@index([serialNumber(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_assets__serial_number_trgm")
  @@index([barcode(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_assets__barcode_trgm")
  @@map("assets")
}

model AssetAssignment {
  id                 String              @id(map: "pk_asset_assignments") @default(uuid()) @db.Uuid
  tenantId           String              @map("tenant_id") @db.Uuid
  assetId            String              @map("asset_id") @db.Uuid
  kind               AssetAssignmentKind
  assignedToUserId   String?             @map("assigned_to_user_id") @db.Uuid
  assignedDepartment String?             @map("assigned_department") @db.VarChar(200)
  assignedLocationId String?             @map("assigned_location_id") @db.Uuid
  assignedByUserId   String              @map("assigned_by_user_id") @db.Uuid
  reason             String?             @db.VarChar(500)
  assignedAt         DateTime            @default(now()) @map("assigned_at") @db.Timestamptz(3)
  unassignedAt       DateTime?           @map("unassigned_at") @db.Timestamptz(3)
  unassignedByUserId String?             @map("unassigned_by_user_id") @db.Uuid
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "fk_asset_assignments__tenants__tenant_id")
  asset            Asset          @relation(fields: [assetId], references: [id], onDelete: Cascade, map: "fk_asset_assignments__assets__asset_id")
  assignedToUser   User?          @relation("AssetAssignmentAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull, map: "fk_asset_assignments__users__assigned_to_user_id")
  assignedLocation AssetLocation? @relation(fields: [assignedLocationId], references: [id], onDelete: SetNull, map: "fk_asset_assignments__locations__assigned_location_id")
  assignedBy       User           @relation("AssetAssignmentActor", fields: [assignedByUserId], references: [id], onDelete: Restrict, map: "fk_asset_assignments__users__assigned_by_user_id")
  unassignedBy     User?          @relation("AssetAssignmentUnassigner", fields: [unassignedByUserId], references: [id], onDelete: SetNull, map: "fk_asset_assignments__users__unassigned_by_user_id")

  @@index([tenantId, assetId, assignedAt], map: "idx_asset_assignments__tenant_asset_assigned_at")
  @@map("asset_assignments")
}

model AssetRelationship {
  id              String                @id(map: "pk_asset_relationships") @default(uuid()) @db.Uuid
  tenantId        String                @map("tenant_id") @db.Uuid
  sourceAssetId   String                @map("source_asset_id") @db.Uuid
  targetAssetId   String                @map("target_asset_id") @db.Uuid
  type            AssetRelationshipType
  note            String?               @db.VarChar(500)
  createdByUserId String                @map("created_by_user_id") @db.Uuid
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt       DateTime?             @map("deleted_at") @db.Timestamptz(3)

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "fk_asset_relationships__tenants__tenant_id")
  sourceAsset Asset  @relation("AssetRelationshipSource", fields: [sourceAssetId], references: [id], onDelete: Cascade, map: "fk_asset_relationships__assets__source_asset_id")
  targetAsset Asset  @relation("AssetRelationshipTarget", fields: [targetAssetId], references: [id], onDelete: Cascade, map: "fk_asset_relationships__assets__target_asset_id")
  createdBy   User   @relation("AssetRelationshipCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, map: "fk_asset_relationships__users__created_by_user_id")

  @@unique([tenantId, sourceAssetId, targetAssetId, type], map: "uq_asset_relationships__tenant_source_target_type")
  @@index([tenantId, targetAssetId], map: "idx_asset_relationships__tenant_id_target_asset_id")
  @@index([tenantId, sourceAssetId], map: "idx_asset_relationships__tenant_id_source_asset_id")
  @@map("asset_relationships")
}

model AssetHistory {
  id          String   @id(map: "pk_asset_history") @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  assetId     String   @map("asset_id") @db.Uuid
  action      String   @db.VarChar(100)
  fromState   String?  @map("from_state") @db.VarChar(50)
  toState     String?  @map("to_state") @db.VarChar(50)
  metadata    Json?    @map("metadata")
  actorUserId String?  @map("actor_user_id") @db.Uuid
  comment     String?  @db.VarChar(1000)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "fk_asset_history__tenants__tenant_id")
  asset  Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade, map: "fk_asset_history__assets__asset_id")
  actor  User?  @relation("AssetHistoryActor", fields: [actorUserId], references: [id], onDelete: SetNull, map: "fk_asset_history__users__actor_user_id")

  @@index([tenantId, assetId, createdAt], map: "idx_asset_history__tenant_asset_created_at")
  @@map("asset_history")
}

model AssetTicketLink {
  id              String   @id(map: "pk_asset_ticket_links") @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  assetId         String   @map("asset_id") @db.Uuid
  ticketId        String   @map("ticket_id") @db.Uuid
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "fk_asset_ticket_links__tenants__tenant_id")
  asset     Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade, map: "fk_asset_ticket_links__assets__asset_id")
  ticket    Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade, map: "fk_asset_ticket_links__tickets__ticket_id")
  createdBy User   @relation("AssetTicketLinkCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, map: "fk_asset_ticket_links__users__created_by_user_id")

  @@unique([tenantId, assetId, ticketId], map: "uq_asset_ticket_links__tenant_asset_ticket")
  @@index([tenantId, ticketId], map: "idx_asset_ticket_links__tenant_id_ticket_id")
  @@index([tenantId, assetId], map: "idx_asset_ticket_links__tenant_id_asset_id")
  @@map("asset_ticket_links")
