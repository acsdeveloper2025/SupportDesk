  @@index([tenantId, articleId], map: "idx_asset_type_kb_links__tenant_article")
  @@map("asset_type_kb_links")
}

model AssetAttachment {
  id           String              @id(map: "pk_asset_attachments") @default(uuid()) @db.Uuid
  tenantId     String              @map("tenant_id") @db.Uuid
  assetId      String              @map("asset_id") @db.Uuid
  kind         AssetAttachmentKind @default(OTHER)
  fileName     String              @map("file_name") @db.VarChar(255)
  originalName String              @map("original_name") @db.VarChar(255)
  mimeType     String              @map("mime_type") @db.VarChar(120)
  sizeBytes    BigInt              @map("size_bytes")
  storagePath  String              @map("storage_path") @db.VarChar(500)
  uploadedById String              @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "fk_asset_attachments__tenants__tenant_id")
  asset      Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade, map: "fk_asset_attachments__assets__asset_id")
  uploadedBy User   @relation("AssetAttachmentUploader", fields: [uploadedById], references: [id], onDelete: Cascade, map: "fk_asset_attachments__users__uploaded_by_id")

  @@index([tenantId, assetId, createdAt], map: "idx_asset_attachments__tenant_asset_created_at")
  @@map("asset_attachments")
}
