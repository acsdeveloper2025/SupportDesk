  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "fk_asset_type_kb_links__tenants__tenant_id")
  assetType AssetType @relation(fields: [assetTypeId], references: [id], onDelete: Cascade, map: "fk_asset_type_kb_links__asset_types__asset_type_id")
  article   KbArticle @relation(fields: [articleId], references: [id], onDelete: Cascade, map: "fk_asset_type_kb_links__articles__article_id")
  createdBy User      @relation("AssetTypeKbLinkCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, map: "fk_asset_type_kb_links__users__created_by_user_id")

