# Shared
NODE_ENV=development
LOG_LEVEL=info

# Web
NEXT_PUBLIC_APP_NAME=SupportDesk
# Server-only URL used by Next.js BFF route handlers to call the NestJS API.
SUPPORTDESK_API_URL=http://localhost:3001
# Public fallback for non-authenticated development calls only. Do not expose auth tokens to browser JavaScript.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# API
API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
SWAGGER_PATH=/docs

# Authentication security
# Argon2id defaults are intentionally conservative for production-like development.
ARGON2_MEMORY_COST_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
ARGON2_HASH_LENGTH=32
SECURE_TOKEN_BYTES=32
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=1440
AUTH_SESSION_TTL_MINUTES=720
AUTH_REMEMBER_ME_SESSION_TTL_MINUTES=43200
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=supportdesk-api
JWT_ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_MINUTES=10080
REMEMBER_ME_REFRESH_TOKEN_TTL_MINUTES=43200
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_REQUESTS=10
AUTH_RATE_LIMIT_LOGIN_MAX=5
AUTH_RATE_LIMIT_REGISTER_MAX=5
AUTH_RATE_LIMIT_VERIFICATION_MAX=10
AUTH_RATE_LIMIT_RESET_REQUEST_MAX=5
AUTH_RATE_LIMIT_RESET_CONFIRM_MAX=10
AUTH_RATE_LIMIT_PASSWORD_CHANGE_MAX=5
AUTH_RATE_LIMIT_REFRESH_MAX=20
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SYMBOL=true

# Database
# Development default matches docker/docker-compose.dev.yml.
DATABASE_URL=postgresql://supportdesk:supportdesk@localhost:5432/supportdesk?schema=public

# Local attachment storage (Issue #23). Never expose this path via the web server.
ATTACHMENTS_STORAGE_ROOT=./data/supportdesk/attachments
ATTACHMENT_MAX_FILE_SIZE_BYTES=10485760
