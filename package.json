{
  "name": "supportdesk",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise multi-tenant ticketing SaaS project foundation.",
  "packageManager": "pnpm@10.6.3",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @supportdesk/api --filter @supportdesk/web dev",
    "build": "pnpm -r --filter './packages/**' build && pnpm --filter @supportdesk/api build && pnpm --filter @supportdesk/web build",
    "prisma:generate": "pnpm --filter @supportdesk/api prisma:generate",
    "lint": "pnpm prisma:generate && eslint . --max-warnings=0",
    "typecheck": "pnpm prisma:generate && pnpm -r typecheck",
    "test": "pnpm prisma:generate && pnpm -r test",
    "coverage:auth": "pnpm --filter @supportdesk/api test:coverage:auth",
    "test:e2e": "env -u FORCE_COLOR -u NO_COLOR pnpm --filter @supportdesk/web test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security:scan": "pnpm audit --audit-level high",
    "audit:deps": "pnpm audit --audit-level high",
    "docker:dev": "docker compose -f docker/docker-compose.dev.yml up --build",
    "docker:dev:down": "docker compose -f docker/docker-compose.dev.yml down",
    "migrate:verify": "bash scripts/verify-migrations.sh",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm security:scan",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,json,md,css}": [
      "prettier --write"
    ],
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --max-warnings=0 --no-warn-ignored"
    ]
  },
  "pnpm": {
    "overrides": {
      "js-yaml": "5.2.2",
      "postcss": "8.5.25",
      "sharp": "0.35.0",
      "test-exclude": "8.0.0"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^15.4.5",
    "@playwright/test": "^1.54.2",
    "@types/node": "^24.1.0",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "turbo": "^2.5.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  }
}
